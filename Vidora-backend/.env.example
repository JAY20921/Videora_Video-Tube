# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# ─── Server ───────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,https://your-production-domain.com

# ─── Auth Tokens ──────────────────────────────────────────
# Industry standard: access=15m, refresh=7d
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Redis (Phase 3: Video Processing) ───────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Meilisearch (Phase 4: Fast Search) ──────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_meili_master_key

# ─── AI & RAG (Phase 5: Knowledge Graph) ─────────────────
# Groq provides free-tier access to Whisper (transcription) and Llama 3.3 (LLM)
# Sign up: https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Qdrant vector database for semantic search / RAG
# Free tier at https://cloud.qdrant.io or local Docker: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key
